<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" default-locale="pt-BR">
  <info>
    <title xml:lang="pt-BR">ABNT NBR 10520:2023 e NBR 6023:2025 — Julio Andreo (autor-data, pt-BR, rev. 2)</title>
    <title-short xml:lang="pt-BR">ABNT 10520:2023 + 6023:2025 — rev. 2</title-short>
    <id>http://www.zotero.org/styles/abnt-nbr-10520-2023-nbr-6023-2025-julio-andreo-rev2</id>
    <link href="http://www.zotero.org/styles/abnt-nbr-10520-2023-nbr-6023-2025-julio-andreo-rev2" rel="self"/>
    <link href="http://www.zotero.org/styles/associacao-brasileira-de-normas-tecnicas-ufrgs-initials" rel="template"/>
    <link href="https://csl.mendeley.com/about/" rel="documentation" xml:lang="pt-BR"/>
    <link href="https://csl.mendeley.com/styles/560229411/universidade-federal-uberlandia" rel="documentation" xml:lang="pt-BR"/>
    <author>
      <name>Julio Andreo</name>
      <email>julio.andreo@ufu.br</email>
    </author>
    <contributor>
      <name>OpenAI — elaboração do código CSL</name>
    </contributor>
    <contributor>
      <name>Julio Andreo — revisão normativa e técnica</name>
      <email>julio.andreo@ufu.br</email>
    </contributor>
    <category citation-format="author-date"/>
    <category field="generic-base"/>
    <summary xml:lang="pt-BR">Estilo CSL independente em português do Brasil (pt-BR). Autoria: Julio Andreo. Elaboração do código CSL: OpenAI. Revisão normativa e técnica: Julio Andreo. Data de elaboração do código: 28 de julho de 2026. Base normativa: ABNT NBR 10520:2023, para citações, e ABNT NBR 6023:2025, para referências. Formato de citação: sistema autor-data, com chamadas parentéticas no padrão (Autor, ano, p. x) e chamadas narrativas no padrão Autor (ano, p. x). Na lista de referências, os prenomes são abreviados e, para quatro ou mais autores, utiliza-se o primeiro autor seguido de et al. Revisão 2: nas citações de autoria pessoal, apresenta somente o sobrenome; a expansão automática para prenomes foi desativada para evitar formas como “John Brian Harley (1988)”.</summary>
    <published>2026-07-28T00:00:00-03:00</published>
    <updated>2026-07-29T18:02:00-03:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/" xml:lang="pt-BR">Este trabalho está licenciado sob a licença Creative Commons Atribuição-CompartilhaIgual 3.0.</rights>
  </info>

  <locale xml:lang="pt-BR">
    <style-options punctuation-in-quote="false"/>
    <terms>
      <term name="and">e</term>
      <term name="and others">et al.</term>
      <term name="et-al">et al.</term>
      <term name="editor" form="short"><single>org.</single><multiple>org.</multiple></term>
      <term name="translator" form="short"><single>trad.</single><multiple>trad.</multiple></term>
      <term name="page" form="short"><single>p.</single><multiple>p.</multiple></term>
      <term name="chapter" form="short">cap.</term>
      <term name="volume" form="short">v.</term>
      <term name="issue" form="short">n.</term>
      <term name="edition" form="short">ed.</term>
      <term name="no date">[s. d.]</term>
      <term name="open-quote">“</term>
      <term name="close-quote">”</term>
      <term name="open-inner-quote">‘</term>
      <term name="close-inner-quote">’</term>
      <term name="month-01" form="short">jan.</term>
      <term name="month-02" form="short">fev.</term>
      <term name="month-03" form="short">mar.</term>
      <term name="month-04" form="short">abr.</term>
      <term name="month-05" form="short">maio</term>
      <term name="month-06" form="short">jun.</term>
      <term name="month-07" form="short">jul.</term>
      <term name="month-08" form="short">ago.</term>
      <term name="month-09" form="short">set.</term>
      <term name="month-10" form="short">out.</term>
      <term name="month-11" form="short">nov.</term>
      <term name="month-12" form="short">dez.</term>
    </terms>
  </locale>

  <!-- NOMES -->
  <macro name="author-bibliography">
    <names variable="author">
      <name name-as-sort-order="all"
            sort-separator=", "
            initialize-with=". "
            initialize="true"
            delimiter="; "
            delimiter-precedes-last="never">
        <name-part name="family" text-case="uppercase"/>
      </name>
      <et-al font-style="italic"/>
    </names>
  </macro>

  <macro name="responsibility-bibliography">
    <names variable="author">
      <name name-as-sort-order="all"
            sort-separator=", "
            initialize-with=". "
            initialize="true"
            delimiter="; "
            delimiter-precedes-last="never">
        <name-part name="family" text-case="uppercase"/>
      </name>
      <et-al font-style="italic"/>
      <substitute>
        <names variable="editor">
          <name name-as-sort-order="all"
                sort-separator=", "
                initialize-with=". "
                initialize="true"
                delimiter="; "
                delimiter-precedes-last="never">
            <name-part name="family" text-case="uppercase"/>
          </name>
          <et-al font-style="italic"/>
          <label form="short" prefix=" (" suffix=")"/>
        </names>
      </substitute>
    </names>
  </macro>

  <macro name="author-citation">
    <names variable="author">
      <name form="short" initialize="false" delimiter="; " delimiter-precedes-last="never">
        <name-part name="family" text-case="capitalize-first"/>
      </name>
      <et-al font-style="italic"/>
      <substitute>
        <names variable="editor">
          <name form="short" initialize="false" delimiter="; " delimiter-precedes-last="never">
            <name-part name="family" text-case="capitalize-first"/>
          </name>
          <et-al font-style="italic"/>
        </names>
        <text variable="title" form="short" text-case="capitalize-first"/>
      </substitute>
    </names>
  </macro>

  <macro name="author-sort">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=", " initialize-with=". " initialize="true"/>
      <substitute>
        <names variable="editor">
          <name name-as-sort-order="all" sort-separator=", " initialize-with=". " initialize="true"/>
        </names>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <macro name="container-editor">
    <names variable="editor">
      <name name-as-sort-order="all"
            sort-separator=", "
            initialize-with=". "
            initialize="true"
            delimiter="; "
            delimiter-precedes-last="never">
        <name-part name="family" text-case="uppercase"/>
      </name>
      <et-al font-style="italic"/>
      <label form="short" prefix=" (" suffix=")"/>
    </names>
  </macro>

  <macro name="translator">
    <names variable="translator">
      <label form="short" suffix=": "/>
      <name initialize-with=". " initialize="true" delimiter="; " delimiter-precedes-last="never"/>
    </names>
  </macro>

  <!-- DATAS -->
  <macro name="issued-year">
    <choose>
      <if variable="issued">
        <date variable="issued">
          <date-part name="year"/>
        </date>
      </if>
      <else>
        <text term="no date"/>
      </else>
    </choose>
  </macro>

  <macro name="issued-date">
    <choose>
      <if variable="issued">
        <date variable="issued">
          <date-part name="day" suffix=" "/>
          <date-part name="month" form="short" suffix=" "/>
          <date-part name="year"/>
        </date>
      </if>
      <else>
        <text term="no date"/>
      </else>
    </choose>
  </macro>

  <macro name="accessed-date">
    <date variable="accessed">
      <date-part name="day" suffix=" "/>
      <date-part name="month" form="short" suffix=" "/>
      <date-part name="year"/>
    </date>
  </macro>

  <!-- ELEMENTOS EDITORIAIS -->
  <macro name="edition">
    <choose>
      <if variable="edition">
        <group delimiter="">
          <text variable="edition"/>
          <text value=". ed."/>
        </group>
      </if>
    </choose>
  </macro>

  <macro name="publisher-place-name">
    <choose>
      <if variable="publisher-place publisher" match="all">
        <group delimiter=": ">
          <text variable="publisher-place"/>
          <text variable="publisher"/>
        </group>
      </if>
      <else-if variable="publisher-place">
        <group delimiter=": ">
          <text variable="publisher-place"/>
          <text value="[s. n.]"/>
        </group>
      </else-if>
      <else-if variable="publisher">
        <group delimiter=": ">
          <text value="[S. l.]"/>
          <text variable="publisher"/>
        </group>
      </else-if>
      <else>
        <text value="[S. l.: s. n.]"/>
      </else>
    </choose>
  </macro>

  <macro name="publication-statement">
    <group delimiter=", ">
      <text macro="publisher-place-name"/>
      <text macro="issued-year"/>
    </group>
  </macro>

  <macro name="volume-issue">
    <group delimiter=", ">
      <group delimiter=" ">
        <label variable="volume" form="short"/>
        <text variable="volume"/>
      </group>
      <group delimiter=" ">
        <label variable="issue" form="short"/>
        <text variable="issue"/>
      </group>
    </group>
  </macro>

  <macro name="pages">
    <group delimiter=" ">
      <label variable="page" form="short"/>
      <text variable="page"/>
    </group>
  </macro>

  <macro name="total-pages">
    <choose>
      <if variable="number-of-pages">
        <group delimiter=" ">
          <text variable="number-of-pages"/>
          <text value="p."/>
        </group>
      </if>
    </choose>
  </macro>

  <macro name="series">
    <choose>
      <if variable="collection-title">
        <group prefix="(" suffix=")" delimiter=", ">
          <text variable="collection-title"/>
          <text variable="collection-number"/>
        </group>
      </if>
    </choose>
  </macro>

  <macro name="standard-identifiers">
    <group delimiter=". ">
      <choose>
        <if variable="ISBN">
          <text variable="ISBN" prefix="ISBN "/>
        </if>
      </choose>
      <choose>
        <if variable="ISSN">
          <text variable="ISSN" prefix="ISSN "/>
        </if>
      </choose>
    </group>
  </macro>

  <macro name="online-access">
    <group delimiter=" ">
      <choose>
        <if variable="DOI">
          <text variable="DOI" prefix="DOI: https://doi.org/" suffix="."/>
        </if>
      </choose>
      <choose>
        <if variable="URL">
          <text variable="URL" prefix="Disponível em: " suffix="."/>
          <choose>
            <if variable="accessed">
              <text macro="accessed-date" prefix="Acesso em: " suffix="."/>
            </if>
          </choose>
        </if>
      </choose>
    </group>
  </macro>

  <macro name="genre-medium">
    <group delimiter=". ">
      <text variable="genre"/>
      <text variable="medium"/>
    </group>
  </macro>

  <!-- MODELOS DE REFERÊNCIA -->
  <macro name="book-reference">
    <group>
      <text macro="responsibility-bibliography" suffix=". "/>
      <text variable="title" font-weight="bold" suffix=". "/>
      <text macro="translator" suffix=". "/>
      <text macro="edition" suffix=" "/>
      <text macro="publication-statement" suffix=". "/>
      <text macro="total-pages" suffix=". "/>
      <text macro="series" suffix=". "/>
      <text macro="standard-identifiers" suffix=". "/>
      <text macro="online-access"/>
    </group>
  </macro>

  <macro name="chapter-reference">
    <group>
      <text macro="author-bibliography" suffix=". "/>
      <text variable="title" suffix=". "/>
      <text value="In" font-style="italic" suffix=": "/>
      <text macro="container-editor" suffix=". "/>
      <text variable="container-title" font-weight="bold" suffix=". "/>
      <text macro="edition" suffix=" "/>
      <text macro="publication-statement" suffix=". "/>
      <choose>
        <if variable="volume">
          <group delimiter=" ">
            <label variable="volume" form="short"/>
            <text variable="volume"/>
          </group>
          <text value=". "/>
        </if>
      </choose>
      <text macro="pages" suffix=". "/>
      <text macro="online-access"/>
    </group>
  </macro>

  <macro name="journal-reference">
    <group>
      <text macro="author-bibliography" suffix=". "/>
      <text variable="title" suffix=". "/>
      <text variable="container-title" font-weight="bold" suffix=", "/>
      <text variable="publisher-place" suffix=", "/>
      <text macro="volume-issue" suffix=", "/>
      <text macro="pages" suffix=", "/>
      <text macro="issued-date" suffix=". "/>
      <text macro="standard-identifiers" suffix=". "/>
      <text macro="online-access"/>
    </group>
  </macro>

  <macro name="newspaper-reference">
    <group>
      <text macro="author-bibliography" suffix=". "/>
      <text variable="title" suffix=". "/>
      <text variable="container-title" font-weight="bold" suffix=", "/>
      <text variable="publisher-place" suffix=", "/>
      <text macro="issued-date" suffix=". "/>
      <text variable="section" suffix=", "/>
      <text macro="pages" suffix=". "/>
      <text macro="online-access"/>
    </group>
  </macro>

  <macro name="conference-reference">
    <group>
      <text macro="author-bibliography" suffix=". "/>
      <text variable="title" suffix=". "/>
      <text value="In" font-style="italic" suffix=": "/>
      <text variable="event" text-case="uppercase" suffix=", "/>
      <text macro="issued-year" suffix=", "/>
      <text variable="event-place" suffix=". "/>
      <text variable="container-title" font-weight="bold" suffix=". "/>
      <text macro="publication-statement" suffix=". "/>
      <text macro="pages" suffix=". "/>
      <text macro="online-access"/>
    </group>
  </macro>

  <macro name="thesis-reference">
    <group>
      <text macro="author-bibliography" suffix=". "/>
      <text variable="title" font-weight="bold" suffix=". "/>
      <text macro="issued-year" suffix=". "/>
      <choose>
        <if variable="number-of-pages">
          <group delimiter=" ">
            <text variable="number-of-pages"/>
            <text value="f."/>
          </group>
          <text value=" "/>
        </if>
      </choose>
      <text variable="genre" suffix=" – "/>
      <text variable="publisher" suffix=", "/>
      <text variable="publisher-place" suffix=", "/>
      <text macro="issued-year" suffix=". "/>
      <text macro="online-access"/>
    </group>
  </macro>

  <macro name="report-reference">
    <group>
      <text macro="responsibility-bibliography" suffix=". "/>
      <text variable="title" font-weight="bold" suffix=". "/>
      <text variable="genre" suffix=". "/>
      <text variable="number" prefix="n. " suffix=". "/>
      <text macro="publication-statement" suffix=". "/>
      <text macro="total-pages" suffix=". "/>
      <text macro="online-access"/>
    </group>
  </macro>

  <macro name="webpage-reference">
    <group>
      <text macro="author-bibliography" suffix=". "/>
      <text variable="title" font-weight="bold" suffix=". "/>
      <text variable="container-title" suffix=", "/>
      <text macro="issued-date" suffix=". "/>
      <text macro="online-access"/>
    </group>
  </macro>

  <macro name="legal-reference">
    <group>
      <text macro="responsibility-bibliography" suffix=". "/>
      <text variable="title" font-weight="bold" suffix=". "/>
      <text variable="number" suffix=". "/>
      <text variable="container-title" font-weight="bold" suffix=", "/>
      <text variable="publisher-place" suffix=", "/>
      <text macro="issued-date" suffix=". "/>
      <text variable="section" suffix=", "/>
      <text macro="pages" suffix=". "/>
      <text variable="authority" suffix=". "/>
      <text variable="references" suffix=". "/>
      <text macro="online-access"/>
    </group>
  </macro>

  <macro name="patent-reference">
    <group>
      <text macro="author-bibliography" suffix=". "/>
      <text variable="title" font-weight="bold" suffix=". "/>
      <text variable="authority" prefix="Titular: " suffix=". "/>
      <text variable="number" suffix=". "/>
      <text macro="issued-date" prefix="Concessão: " suffix=". "/>
      <text macro="online-access"/>
    </group>
  </macro>

  <macro name="audiovisual-reference">
    <group>
      <text macro="responsibility-bibliography" suffix=". "/>
      <text variable="title" font-weight="bold" suffix=". "/>
      <text macro="genre-medium" suffix=". "/>
      <text macro="publication-statement" suffix=". "/>
      <text variable="note" suffix=". "/>
      <text macro="online-access"/>
    </group>
  </macro>

  <macro name="dataset-map-reference">
    <group>
      <text macro="responsibility-bibliography" suffix=". "/>
      <text variable="title" font-weight="bold" suffix=". "/>
      <text macro="genre-medium" suffix=". "/>
      <text variable="scale" prefix="Escala " suffix=". "/>
      <text macro="publication-statement" suffix=". "/>
      <text variable="version" prefix="Versão " suffix=". "/>
      <text macro="online-access"/>
    </group>
  </macro>

  <macro name="personal-communication-reference">
    <group>
      <text macro="author-bibliography" suffix=". "/>
      <text variable="title" font-weight="bold" suffix=". "/>
      <text macro="genre-medium" suffix=". "/>
      <text macro="issued-date" suffix=". "/>
      <text variable="note" suffix=". "/>
    </group>
  </macro>

  <macro name="generic-reference">
    <group>
      <text macro="responsibility-bibliography" suffix=". "/>
      <text variable="title" font-weight="bold" suffix=". "/>
      <text variable="container-title" suffix=". "/>
      <text macro="genre-medium" suffix=". "/>
      <text macro="publication-statement" suffix=". "/>
      <text macro="pages" suffix=". "/>
      <text macro="online-access"/>
    </group>
  </macro>

  <!-- CITAÇÕES: sistema autor-data -->
  <citation et-al-min="4"
            et-al-use-first="1"
            disambiguate-add-givenname="false"
            disambiguate-add-names="false"
            disambiguate-add-year-suffix="true"
            collapse="year-suffix">
    <sort>
      <key macro="author-sort"/>
      <key variable="issued"/>
    </sort>
    <layout prefix="(" suffix=")" delimiter="; ">
      <group delimiter=", ">
        <text macro="author-citation"/>
        <text macro="issued-year"/>
        <group delimiter=" ">
          <label variable="locator" form="short"/>
          <text variable="locator"/>
        </group>
      </group>
    </layout>
  </citation>

  <!-- REFERÊNCIAS: ordem alfabética, alinhamento à esquerda, espaço simples -->
  <bibliography et-al-min="4"
                et-al-use-first="1"
                line-spacing="1"
                entry-spacing="1">
    <sort>
      <key macro="author-sort"/>
      <key variable="issued" sort="ascending"/>
      <key variable="title"/>
    </sort>
    <layout>
      <choose>
        <if type="book pamphlet" match="any">
          <text macro="book-reference"/>
        </if>
        <else-if type="chapter entry-dictionary entry-encyclopedia" match="any">
          <text macro="chapter-reference"/>
        </else-if>
        <else-if type="article-journal article-magazine review review-book" match="any">
          <text macro="journal-reference"/>
        </else-if>
        <else-if type="article-newspaper">
          <text macro="newspaper-reference"/>
        </else-if>
        <else-if type="paper-conference">
          <text macro="conference-reference"/>
        </else-if>
        <else-if type="thesis">
          <text macro="thesis-reference"/>
        </else-if>
        <else-if type="report manuscript">
          <text macro="report-reference"/>
        </else-if>
        <else-if type="webpage post post-weblog" match="any">
          <text macro="webpage-reference"/>
        </else-if>
        <else-if type="bill legal_case legislation treaty" match="any">
          <text macro="legal-reference"/>
        </else-if>
        <else-if type="patent">
          <text macro="patent-reference"/>
        </else-if>
        <else-if type="motion_picture broadcast song speech interview" match="any">
          <text macro="audiovisual-reference"/>
        </else-if>
        <else-if type="dataset map graphic figure musical_score" match="any">
          <text macro="dataset-map-reference"/>
        </else-if>
        <else-if type="personal_communication">
          <text macro="personal-communication-reference"/>
        </else-if>
        <else>
          <text macro="generic-reference"/>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>
